<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="paymentService"
          class="com.spring.ioc.lab.dependencyinjection.CreditCardPayment"/>

    <!-- Constructor injection -->
    <bean id="constructorInjected"
          class="com.spring.ioc.lab.dependencyinjection.OrderServiceConstructor">
        <constructor-arg ref="paymentService"/>
    </bean>

    <!-- Setter injection -->
    <bean id="setterInjected"
          class="com.spring.ioc.lab.dependencyinjection.OrderServiceSetter">
        <property name="paymentService" ref="paymentService"/>
    </bean>
</beans>