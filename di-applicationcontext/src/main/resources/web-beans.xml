<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="greetingService" class="com.example.appcontext.common.GreetingService">
        <property name="message" value="Hello from GenericWebApplicationContext!"/>
    </bean>

    <!-- Request-scoped bean (will only exist inside a web request) -->
    <bean id="requestScopedBean" class="com.example.appcontext.web.RequestScopedBean" scope="request"/>
</beans>